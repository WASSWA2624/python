# Over 1.5 Goals - Match Analysis Tool
#
# Copy to `.env` and edit. `.env` is git-ignored; this file is not.
#
# Every setting below is optional: leaving a line commented out uses the
# built-in default from config.py. The environment sits third in the
# precedence order, so a command-line flag or an interactive answer always
# wins over anything set here:
#
#     flag  >  prompt  >  environment / .env  >  default
#
# Both the prefixed name (OVER15_MIN_ODDS) and the bare name from the
# specification (MIN_ODDS) are read; the prefixed form wins when both are set.


# ---------------------------------------------------------------------------
# Promptable settings (specification 2.1)
# ---------------------------------------------------------------------------
# Setting any of these here means the interactive prompt still offers it -
# only a command-line flag suppresses the prompt for a setting.

# OVER15_MIN_PROBABILITY=70.0     # percent; a match must reach this to qualify
# OVER15_MIN_ODDS=1.20            # decimal; a match must be priced at or above
# OVER15_WINDOW_START=00:00       # EAT, 24-hour
# OVER15_WINDOW_END=23:59         # EAT, 24-hour
# OVER15_DEFAULT_NEXT_HOURS=6     # the default offered by prompt option [2]


# ---------------------------------------------------------------------------
# Remaining qualification thresholds (specification 9)
# ---------------------------------------------------------------------------
# OVER15_MAX_ODDS=5.00
# OVER15_MIN_VALUE=0.00           # model probability minus fair implied
# OVER15_MIN_H2H_MATCHES=3
# OVER15_MIN_FORM_MATCHES=5
# OVER15_REQUIRE_H2H_SAMPLE=false # true also excludes a thin head-to-head
# OVER15_CONTRADICTION_MARGIN=0.25


# ---------------------------------------------------------------------------
# Ranking and categories (specification 7, 8)
# ---------------------------------------------------------------------------
# The two ranking weights must sum to 1.0 or the run stops with an error.
# OVER15_W_PROBABILITY=0.60
# OVER15_W_VALUE=0.40

# OVER15_TOP_PICK_MIN_PROBABILITY=80.0
# OVER15_TOP_PICK_MIN_VALUE=0.00
# OVER15_TOP_PICK_MIN_COMPLETENESS=0.60
# OVER15_TOP_PICK_MIN_CONFIDENCE=Medium
# OVER15_HIGH_ODDS_MIN_ODDS=2.00
# OVER15_HIGH_ODDS_MIN_VALUE=0.05


# ---------------------------------------------------------------------------
# The model (specification 5)
# ---------------------------------------------------------------------------
# The six blend weights must sum to 1.0.
# OVER15_WEIGHT_RECENT_FORM=0.30
# OVER15_WEIGHT_HOME_AWAY_SPLIT=0.20
# OVER15_WEIGHT_OVER15_RATE=0.20
# OVER15_WEIGHT_H2H=0.15
# OVER15_WEIGHT_LEAGUE=0.10
# OVER15_WEIGHT_CONTEXT=0.05

# OVER15_HOME_ADVANTAGE=1.10      # tilts the split, not the expected total
# OVER15_SHRINKAGE_STRENGTH=5.0   # larger pulls small samples harder to baseline
# OVER15_USE_DIXON_COLES=false
# OVER15_DIXON_COLES_RHO=0.00     # must be in [0, 1)
# OVER15_LAMBDA_FLOOR=0.20
# OVER15_LAMBDA_CEILING=6.00
# OVER15_FORM_WINDOW=10           # matches per team, specification 4.2
# OVER15_H2H_MAX_AGE_YEARS=3.0    # older meetings are dropped entirely
# OVER15_H2H_HALFLIFE_YEARS=2.0
# OVER15_LEAGUE_HOME_GOAL_SHARE=0.55


# ---------------------------------------------------------------------------
# Fixture collection (specification 3)
# ---------------------------------------------------------------------------
# Automated collection is OFF by default. gsb.ug returns HTTP 403 to
# non-browser clients, so its robots.txt cannot be read and permission cannot
# be established - see the access policy at the top of gsb_scraper.py. Turn
# this on only after satisfying yourself that the site's terms allow it. An
# explicit Disallow in robots.txt is never overridden.
# OVER15_ALLOW_SCRAPING=false
# OVER15_RESPECT_ROBOTS=true

# OVER15_GSB_URL=https://gsb.ug/sportsbook/upcoming
# OVER15_USER_AGENT=Over15GoalsAnalysisBot/1.0 (statistical research)
# OVER15_HEADLESS=true
# OVER15_PAGE_TIMEOUT_MS=45000
# OVER15_MAX_RETRIES=3
# OVER15_BACKOFF_BASE=2.0
# OVER15_SCROLL_PASSES=25
# OVER15_JSON_SNIFF=true

# CSS selectors for the fixture list. Left empty, the parser falls back to
# heuristics; set them once you have confirmed the live markup.
# OVER15_SELECTOR_FIXTURE_ROW=
# OVER15_SELECTOR_LEAGUE=
# OVER15_SELECTOR_HOME=
# OVER15_SELECTOR_AWAY=
# OVER15_SELECTOR_KICKOFF=
# OVER15_SELECTOR_OVER15=
# OVER15_SELECTOR_UNDER15=


# ---------------------------------------------------------------------------
# Statistics (specification 4)
# ---------------------------------------------------------------------------
# Comma-separated: footballdata_couk, football_data_org, none
# OVER15_STATS_PROVIDERS=footballdata_couk
# OVER15_RESULTS_CSV=                       # date,league,home,away,home_goals,away_goals
# OVER15_SEASONS_BACK=2
# OVER15_STATS_TIMEOUT_SECONDS=30

# Only needed for the football_data_org provider. Never commit a real key.
# FOOTBALL_DATA_API_KEY=


# ---------------------------------------------------------------------------
# Data quality (specification 12)
# ---------------------------------------------------------------------------
# OVER15_FUZZY_THRESHOLD=85.0     # below this a name link is flagged, not assumed
# OVER15_ALIAS_FILE=data/team_aliases.json


# ---------------------------------------------------------------------------
# Output and caching (specification 10)
# ---------------------------------------------------------------------------
# The workbook is always named YYYY-MM-DD.xlsx from the match date alone.
# OVER15_OUTPUT_DIR=results
# OVER15_EXCEL_LOCK_RETRIES=5
# OVER15_EXCEL_LOCK_BACKOFF=1.5
# OVER15_CACHE_DIR=.cache
# OVER15_CACHE_TTL_MINUTES=30
# OVER15_USE_CACHE=true


# ---------------------------------------------------------------------------
# Logging (specification 12)
# ---------------------------------------------------------------------------
# OVER15_LOG_LEVEL=INFO           # DEBUG, INFO, WARNING, ERROR
# OVER15_LOG_FILE=logs/over15.log


# ---------------------------------------------------------------------------
# Unattended runs
# ---------------------------------------------------------------------------
# Setting CI (to anything) suppresses every prompt, as does a non-TTY stdin.
# CI=1
